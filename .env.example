# FieldNotes Environment Configuration
# Copy this to .env and fill in your keys

# ── Required ──────────────────────────────────────────
# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# ── AI Parsing (at least one required) ────────────────
# DeepSeek (cheapest, recommended for MVP)
DEEPSEEK_API_KEY=
# OpenAI (fallback)
OPENAI_API_KEY=

# ── Email (Resend) ────────────────────────────────────
# https://resend.com — free tier: 100 emails/day
RESEND_API_KEY=

# ── Server ────────────────────────────────────────────
# Public URL for Telegram webhook (e.g. https://fieldnotes.ai)
PUBLIC_URL=http://localhost:8765

# ── FN-1: Jev (TypeSafe System One) parse-chain adapter ──
# Access + pricing: docs.typesafe.ai. Key from console.typesafe.ai.
TYPESAFE_API_KEY=
# current (default) | shadow | jev — see backend/services/parser/__init__.py
PARSER_BACKEND=current
# COGS guardrail — daily Jev token cap (input+output). When set and
# exceeded, PARSER_BACKEND=jev fails CLOSED to the current chain for
# the rest of the day. Empty/unset = no cap enforced.
JEV_DAILY_TOKEN_CAP=
